# ── Cấu hình Bridge (copy file này thành .env rồi sửa) ──────────────────
# Kênh TikTok đang phát Live (có hoặc không có @ đều được)
TIKTOK_USER=@zenfacts_vn

# Địa chỉ JSON-RPC của VPS.
#  - Nếu mở cổng 3000 trực tiếp:  http://IP_VPS:3000/rpc
#  - Nếu dùng Caddy + tên miền:   https://chua.example.com/rpc
VPS_RPC_URL=http://IP_VPS:3000/rpc

# Token bảo mật của VPS (lấy từ file .env trên VPS, dòng RPC_TOKEN=...)
RPC_TOKEN=

# Đặt 1 để chỉ in sự kiện ra màn hình, KHÔNG gửi lên VPS (dùng để thử).
DRY_RUN=
